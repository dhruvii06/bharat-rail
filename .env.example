# Copy to .env and fill in. Read by the Node API (npm run api), the Java service (npm run service)
# and the database setup script (npm run db:setup).

# PostgreSQL shared by the Node API (users, login) and the Java incident service (everything else).
ITSM_DB_PASSWORD=
# ITSM_DB_HOST=localhost
# ITSM_DB_PORT=5432
# ITSM_DB_NAME=irctc_itsm
# ITSM_DB_USER=itsm_user

# Node API → Java incident service (localhost only). Set the same token for both outside development.
# ITSM_SERVICE_URL=http://127.0.0.1:8081
# ITSM_INTERNAL_TOKEN=
# ITSM_SLA_CHECK_SECONDS=30

# Node API port. Password for every seeded demo account (defaults to the value in backend/seed/demoUsers.ts).
PORT=3001
# DEMO_PASSWORD=

# Frontend: the Vite dev server forwards /api to the Node API.
VITE_API_BASE_URL=/api/v1
