classDiagram
direction LR

%% Bharat Rail ITSM — core Java domain and OOP design patterns.
%% UML is based on the actual java/domain source code, not on hypothetical API methods.
%% The exception hierarchy and simulated dependency graph are in domain-class-diagram-extensions.mmd.

class User {
  <<abstract>>
  -UUID id
  -String name
  -String email
  +getId() UUID
  +getName() String
  +getEmail() String
  +getRole() String
}
class Reporter {
  <<abstract>>
}
class Employee {
  +getRole() String
}
class Customer {
  +getRole() String
}
class Technician {
  -Set~Skill~ skills
  -int maxConcurrentIncidents
  -int activeIncidents
  -boolean available
  +isAvailable() boolean
  +setAvailable(boolean) void
  +takeIncident() void
  +finishIncident() void
}
class Administrator {
  +getRole() String
}
User <|-- Reporter
Reporter <|-- Employee
Reporter <|-- Customer
User <|-- Technician
User <|-- Administrator

class Incident {
  -UUID id
  -String title
  -String description
  -IncidentStatus status
  -Priority priority
  -Reporter reporter
  -RailwayService affectedService
  -IncidentCategory category
  -Technician assignedTechnician
  -SLAPolicy slaPolicy
  -List~AuditEntry~ auditTrail
  -Resolution resolution
  -TransferRequest pendingHandover
  +classify(Priority, User, Instant) void
  +assign(Technician, User, Instant) void
  +acknowledge(Technician, Instant) void
  +startInvestigation(Technician, Instant) void
  +requestInformation(Technician, String, Instant) void
  +provideInformation(Reporter, String, Instant) void
  +resolve(Technician, String, String, Instant) void
  +verify(Reporter, Instant) void
  +close(Administrator, Instant) void
  +edit(User, String, String, IncidentCategory, Instant) void
  +changePriority(Priority, SLAPolicy, Administrator, String, Instant) void
  +requestHandover(Technician, Technician, String, Instant) void
  +acceptHandover(Technician, Instant) void
  +declineHandover(Technician, String, Instant) void
  +withdrawHandover(Technician, Instant) void
  +handOff(Technician, Technician, String, Instant) void
  +handBack(Technician, String, Instant) void
}
class IncidentCategory {
  <<valueObject>>
  -String code
  -String label
  -Skill handledBy
  +of(String, String, Skill) IncidentCategory
  +isSecurity() boolean
}
class RailwayService {
  -UUID id
  -String name
  -int businessCriticality
  -boolean tatkalBookingPath
  +getBusinessCriticality() int
  +isOnTatkalBookingPath() boolean
}
class SLAPolicy {
  <<record>>
  +Priority priority
  +Duration responseTarget
  +Duration resolutionTarget
  +forPriority(Priority) SLAPolicy
}
class Resolution {
  <<record>>
  +String summary
  +String rootCause
  +Instant resolvedAt
}
class AuditEntry {
  <<record>>
  +UUID incidentId
  +Instant timestamp
  +UUID actorId
  +String action
  +IncidentStatus previousStatus
  +IncidentStatus newStatus
  +String details
}
class TransferRequest {
  <<record>>
  +Technician from
  +Technician to
  +String reason
  +Instant requestedAt
}
Incident "0..*" --> "1" Reporter : reported by
Incident "0..*" --> "1" RailwayService : affects
Incident "0..*" --> "1" IncidentCategory : category
Incident "0..*" --> "0..1" Technician : assigned to
Incident "0..*" --> "0..1" SLAPolicy : SLA
Incident "1" *-- "0..1" Resolution : owns
Incident "1" *-- "0..*" AuditEntry : audit history
Incident "1" *-- "0..1" TransferRequest : pending handover
Incident "1" o-- "0..*" Technician : past contributors
TransferRequest --> Technician : from / to

class PriorityStrategy {
  <<interface>>
  +calculate(Incident) Priority
}
class RailwayPriorityStrategy {
  +calculate(Incident) Priority
}
PriorityStrategy <|.. RailwayPriorityStrategy
RailwayPriorityStrategy ..> Incident : evaluates

class AssignmentStrategy {
  <<interface>>
  +select(Incident, List~Technician~) Technician
}
class SkillBasedAssignmentStrategy {
  +select(Incident, List~Technician~) Technician
}
class LoadBasedAssignmentStrategy {
  +select(Incident, List~Technician~) Technician
}
AssignmentStrategy <|.. SkillBasedAssignmentStrategy
AssignmentStrategy <|.. LoadBasedAssignmentStrategy

class IncidentRepository {
  <<interface>>
  +save(Incident) void
  +findById(UUID) Optional~Incident~
  +findAll() List~Incident~
}
class InMemoryIncidentRepository
IncidentRepository <|.. InMemoryIncidentRepository

class IncidentEvent {
  <<record>>
  +UUID incidentId
  +String type
  +String message
  +Instant timestamp
}
class IncidentListener {
  <<interface>>
  +onEvent(IncidentEvent) void
}
class NotificationSender {
  <<interface>>
}
class EventPublisher {
  -List~IncidentListener~ listeners
  +subscribe(IncidentListener) void
  +publish(IncidentEvent) void
}
class EmailNotification {
  +onEvent(IncidentEvent) void
}
class InAppNotification {
  +onEvent(IncidentEvent) void
}
IncidentListener <|-- NotificationSender : extends
NotificationSender <|.. EmailNotification
NotificationSender <|.. InAppNotification
EventPublisher o-- IncidentListener : subscribers
EventPublisher ..> IncidentEvent : publishes

class IncidentManagementService {
  -IncidentRepository repository
  -PriorityStrategy priorityStrategy
  -AssignmentStrategy assignmentStrategy
  -EventPublisher publisher
  +report(Incident) Incident
  +classifyAndAssign(Incident, Administrator, List~Technician~, Instant) void
  +findPotentialDuplicates(Incident) List~Incident~
}
IncidentManagementService --> IncidentRepository : persists
IncidentManagementService --> PriorityStrategy : prioritizes
IncidentManagementService --> AssignmentStrategy : assigns
IncidentManagementService --> EventPublisher : notifies
